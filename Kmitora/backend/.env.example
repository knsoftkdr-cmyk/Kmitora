# Copy to .env (or export these in your shell) and adjust as needed.
# All three services (F1033_server.py, kmitora_source_api.py,
# kmitora_target_api.py) read KMITORA_ALLOWED_ORIGIN so CORS stays
# consistent across all of them instead of each hardcoding its own origin.

KMITORA_HOST=127.0.0.1
KMITORA_PORT=8080
KMITORA_SOURCE_API_PORT=8081
KMITORA_TARGET_API_PORT=8082

# Origin allowed to call all three APIs directly (bypassing the vite proxy).
# Must match the frontend dev server / deployed frontend origin.
KMITORA_ALLOWED_ORIGIN=http://localhost:5173

# Compiles the business rules document into an executable transform spec
# (once per rules document, not per row). Without a key, discovery still
# runs and rows pass through untransformed.
#
# Free-tier keys exhaust their daily quota quickly, so more than one may be
# supplied. A quota rejection (HTTP 429) rotates to the next key. Use any
# of these forms - they are merged in this order and de-duplicated:
#   GEMINI_API_KEY=key-one
#   GEMINI_API_KEYS=key-two,key-three
#   GEMINI_API_KEY_2=key-four      (through GEMINI_API_KEY_9)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
