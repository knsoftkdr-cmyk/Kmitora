# Copy to .env.local and adjust for your machine. All of these are optional —
# omitted values fall back to empty/relative defaults, none of them need to
# point at a Windows path anymore.

# Base URL for the main API. Leave blank to use the vite dev proxy (see
# vite.config.ts), which forwards /api, /v1 and /health to 127.0.0.1:8080.
VITE_API_BASE=

# Pre-filled paths for the "browse server files" flow in Connect.tsx. These
# are paths on the machine running the *backend*, not the browser, so there
# is no universal default. Leave blank to start the browser at the backend's
# reported root instead.
VITE_SOURCE_DEFAULT_PATH=
VITE_TARGET_DEFAULT_PATH=

# Root of the recovered banking multi-format test pack, if you use it.
VITE_BANKING_PACK_PATH=

# Location of the discovery business-rules file used by auto-orchestration.
VITE_BUSINESS_RULES_PATH=
